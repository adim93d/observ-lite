# observ-lite environment configuration
#
# Copy values into a systemd EnvironmentFile or export them before running.

# Directory that receives system_snapshot.jsonl, os_warnings.log, and kernel_warnings.log.
# Default: /var/log/observ-lite
OBSERV_LITE_LOG_DIR=/var/log/observ-lite

# Timeout in seconds for each external command.
# Default: 8
OBSERV_LITE_COMMAND_TIMEOUT=8

# Maximum captured output characters per external command.
# Default: 20000
OBSERV_LITE_MAX_OUTPUT_CHARS=20000

